# Normalize text files in the repository.
* text=auto

# Source and project configuration use LF in Git and working trees.
*.c text eol=lf
*.cc text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.cs text eol=lf
*.ini text eol=lf
*.json text eol=lf
*.uproject text eol=lf
*.uplugin text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.vsconfig text eol=lf
*.usf text eol=lf
*.ush text eol=lf
# Windows command files require CRLF for broad tool compatibility.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.sln text eol=crlf
*.slnx text eol=crlf
# Unreal assets and other binary files must never be text-merged.
*.uasset binary
*.umap binary
*.ubulk binary
*.uexp binary
*.ufont binary
*.udic binary
# Common binary content.
*.bmp binary
*.gif binary
*.ico binary
*.jpg binary
*.jpeg binary
*.png binary
*.tga binary
*.tif binary
*.tiff binary
*.exr binary
*.hdr binary
*.wav binary
