# Normalize text files in the repository.
* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf

# Source and project configuration use LF in Git and working trees.
*.c text eol=lf
*.cc text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.cs text eol=lf
*.ini text eol=lf
*.json text eol=lf
*.uproject text eol=lf
*.uplugin text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.vsconfig text eol=lf
*.usf text eol=lf
*.ush text eol=lf
# Windows command files require CRLF for broad tool compatibility.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.sln text eol=crlf
*.slnx text eol=crlf
# Unreal assets are stored with Git LFS and must never be text-merged.
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text
*.ubulk filter=lfs diff=lfs merge=lfs -text
*.uexp filter=lfs diff=lfs merge=lfs -text
*.ufont filter=lfs diff=lfs merge=lfs -text
*.udic filter=lfs diff=lfs merge=lfs -text
# Large source-art, audio, video, and archive files use Git LFS.
*.psd filter=lfs diff=lfs merge=lfs -text
*.exr filter=lfs diff=lfs merge=lfs -text
*.hdr filter=lfs diff=lfs merge=lfs -text
*.tga filter=lfs diff=lfs merge=lfs -text
*.tif filter=lfs diff=lfs merge=lfs -text
*.tiff filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.glb filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.flac filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.mov filter=lfs diff=lfs merge=lfs -text
*.avi filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
*.7z filter=lfs diff=lfs merge=lfs -text
# Common binary content.
*.bmp binary
*.gif binary
*.ico binary
*.jpg binary
*.jpeg binary
*.png binary
*.mp3 binary
*.ogg binary
*.gltf binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.pdf binary
